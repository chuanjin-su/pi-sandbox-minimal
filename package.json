{
	"name": "pi-sandbox-minimal",
	"version": "0.1.0",
	"description": "OS-level sandboxing for pi with interactive permission prompts: sandboxed bash plus read/write/edit/ls/grep/find interception, /sandbox menu",
	"keywords": [
		"pi-package",
		"pi-extension"
	],
	"type": "module",
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "tsx --test test/*.test.ts",
		"all": "npm run check && npm test"
	},
	"dependencies": {
		"@carderne/sandbox-runtime": "^0.0.72"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.85.0",
		"@earendil-works/pi-coding-agent": ">=0.85.0",
		"@earendil-works/pi-tui": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@earendil-works/pi-tui": "^0.85.0",
		"@types/node": "^24",
		"tsx": "^4.23.1",
		"typescript": "^5"
	},
	"license": "MIT"
}
